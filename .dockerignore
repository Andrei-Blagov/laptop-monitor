# Whitelist. The build context is the extracted release bundle sitting next to
# host-only state (.env, data/, logs/, backups/), so deny everything and allow
# only runtime paths. Must match IMAGE_ALLOW_PATTERNS in scripts/release_manifest.py.
*
!VERSION
!requirements.txt
!RELEASE_MANIFEST.json
!*.py
!parsers
!stores
!integrations
!thailand
!ops
!scripts
**/__pycache__
**/*.py[cod]
scripts/windows
