# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin allowlist for control bot (comma-separated). Defaults to TELEGRAM_CHAT_ID.
TELEGRAM_ADMIN_CHAT_ID=

# Instance id written into pipeline_runs / status
LAPTOP_MONITOR_INSTANCE=local-dev

# Geography for cross-store comparisons (moscow)
MONITOR_REGION=moscow

# Optional n8n OPS webhook (empty = disabled). Best-effort; never fails pipeline.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_TIMEOUT_SECONDS=8
