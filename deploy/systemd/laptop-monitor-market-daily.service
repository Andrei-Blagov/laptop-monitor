[Unit]
Description=Enqueue the shared Thailand market check (one daily pass)
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/laptop-monitor
ExecStart=/opt/laptop-monitor/deploy/compose.sh run --rm --no-deps pipeline python -m thailand.market_schedule enqueue-daily
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
