[Unit]
Description=Laptop Monitor Telegram control bot (Docker Compose)
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/laptop-monitor
ExecStart=/opt/laptop-monitor/deploy/compose.sh up -d control-bot
ExecStop=/opt/laptop-monitor/deploy/compose.sh stop control-bot
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
