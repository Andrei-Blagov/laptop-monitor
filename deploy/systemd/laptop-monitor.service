[Unit]
Description=Laptop Monitor pipeline (Docker Compose)
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/laptop-monitor
ExecStart=/opt/laptop-monitor/deploy/compose.sh run --rm --no-deps pipeline python run_pipeline.py
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
