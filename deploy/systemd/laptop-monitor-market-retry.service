[Unit]
Description=Wake one due Thailand deferred or delivery retry
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/laptop-monitor
ExecStart=/opt/laptop-monitor/deploy/compose.sh run --rm --no-deps pipeline python -m thailand.worker --once
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
