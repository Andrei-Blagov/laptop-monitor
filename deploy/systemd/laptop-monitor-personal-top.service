[Unit]
Description=Enqueue the personal TOP-3 Thailand check (one shared scan)
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/laptop-monitor
ExecStart=/opt/laptop-monitor/deploy/compose.sh run --rm --no-deps pipeline python -m personal_top enqueue
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
