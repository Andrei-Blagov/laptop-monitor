        "jsCode": "// FAIL CLOSED HMAC — deploy/n8n/HMAC.md\n// Canonical: HMAC_SHA256(secret, timestamp + '.' + exact_raw_body_bytes)\n// NEVER use JSON.stringify(parsedBody) as a raw-body substitute.\nconst crypto = require('crypto');\n\nfunction reject(reason) {\n  return [{ json: { verified: false, error: reason } }];\n}\n\nconst secret = $env.LAPTOP_MONITOR_WEBHOOK_SECRET;\nif (!secret) return reject('missing_secret');\n\nconst item = $input.first();\nconst headers = (item.json && item.json.headers) ? item.json.headers : {};\nconst ts = headers['x-laptop-monitor-timestamp'] || headers['X-Laptop-Monitor-Timestamp'];\nconst sig = headers['x-laptop-monitor-signature'] || headers['X-Laptop-Monitor-Signature'];\nif (!ts) return reject('missing_timestamp');\nif (!sig) return reject('missing_signature');\nif (!item.binary || !item.binary.data) return reject('missing_raw_body');\n\nlet raw;\ntry {\n  raw = await this.helpers.getBinaryDataBuffer(0, 'data');\n} catch (e) {\n  return reject('missing_raw_body');\n}\nif (!raw || !Buffer.isBuffer(raw) || raw.length === 0) return reject('missing_raw_body');\n\nconst tsNum = Number(ts);\nif (!Number.isFinite(tsNum)) return reject('bad_timestamp');\nconst skew = Math.abs(Math.floor(Date.now() / 1000) - Math.floor(tsNum));\nif (skew > 300) return reject('timestamp_skew');\n\nconst expected = crypto\n  .createHmac('sha256', secret)\n  .update(Buffer.concat([\n    Buffer.from(String(ts), 'utf8'),\n    Buffer.from('.', 'utf8'),\n    raw,\n  ]))\n  .digest('hex');\n\nconst a = Buffer.from(expected, 'utf8');\nconst b = Buffer.from(String(sig), 'utf8');\nif (a.length !== b.length || !crypto.timingSafeEqual(a, b)) {\n  return reject('bad_signature');\n}\n\nlet payload;\ntry {\n  payload = JSON.parse(raw.toString('utf8'));\n} catch (e) {\n  return reject('invalid_json');\n}\n\nreturn [{\n  json: {\n    verified: true,\n    event: payload.event,\n    status: payload.status,\n    app_version: payload.app_version,\n    instance_id: payload.instance_id,\n    run_id: payload.run_id,\n    alerts_created: payload.alerts_created,\n    messages_sent: payload.messages_sent,\n    messages_failed: payload.messages_failed,\n    stores: payload.stores,\n    top_deals: payload.top_deals,\n  },\n}];\n"
      },
